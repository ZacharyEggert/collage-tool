{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Collage Tool",
  "version": "0.1.0",
  "identifier": "llc.ex-nihilo.collage-tool",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Collage Tool",
        "width": 1000,
        "height": 750
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
